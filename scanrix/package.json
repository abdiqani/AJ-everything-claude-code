{
  "name": "scanrix",
  "version": "0.1.0",
  "private": true,
  "description": "URL-based vulnerability scanning SaaS platform",
  "workspaces": [
    "packages/api",
    "packages/worker",
    "packages/web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=packages/api\" \"npm run dev --workspace=packages/worker\" \"npm run dev --workspace=packages/web\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "db:migrate": "npm run migrate --workspace=packages/api",
    "docker:up": "docker compose -f docker-compose.yml up -d",
    "docker:down": "docker compose -f docker-compose.yml down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  }
}
